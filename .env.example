# Copy this file to .env and fill in real values before running `docker compose up`.
# docker-compose.yml reads these; see enterprise_conf.py/enterprise_user_conf.py for how the
# app itself consumes them.

# Flask session secret. Required - docker-compose.yml refuses to start without it.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(20))"
TE_FLASK_KEY=

# App-level encryption key used to protect per-engagement data. Required.
# Changing this AFTER you have real engagement data will make it unreadable - pick it once.
TE_HASH_KEY=

# Optional: deterministic first-run admin login (recommended for Docker - otherwise a random
# username/password is generated and only visible in the container's startup logs).
TE_ADMIN_USERNAME=
TE_ADMIN_PASSWORD=

# Optional: stable ZAP daemon API key. If unset, a fresh one is generated each container start
# (fine unless you need it to survive restarts for some external integration).
TE_ZAP_API_KEY=

# Optional: Metasploit RPC daemon credentials (msfrpcd, started inside the app container).
TE_MSFRPC_USER=
TE_MSFRPC_PASSWORD=

# RabbitMQ credentials - shared between the app service and the rabbitmq service itself in
# docker-compose.yml, so change both together, not just one.
TE_RABBITMQ_USER=guest
TE_RABBITMQ_PASS=guest

# Host port the Flask app's HTTPS listener is published on (container always listens on 1820).
TE_FLASK_PORT=1820
